# ==========================================
# Gaming Zone Shift Management - .gitignore
# ==========================================

# --- Live Runtime Shift & Audit Data ---
local_data/
local_data_dev/
uploads/
screenshots/
sync_errors.jsonl
*.tmp
*.log
installer/output/

# --- Sensitive API & Google Credentials ---
credentials.json
sheet_id.txt
imgbb_key.txt

# --- Live Counter Settings & PIN Hashes ---
# (Use settings.example.json as a clean template)
settings.json

# --- Python Cache & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
.env
.venv/
venv/
env/

# --- PyInstaller Build Folders ---
build/
dist/
*.new.exe
GamingZoneShiftSetup.exe
Equilibrium-Shift-Form.exe
*Shift-Form-Installer.exe
*.spec

# --- IDE & OS Files ---
.vscode/
.idea/
Thumbs.db
Desktop.ini
Equilibrium-Shift-Form/
